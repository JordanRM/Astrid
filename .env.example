# Copied automatically from the old elizaOS .env by scripts/setup.sh.
DATABASE_URL=postgresql://user:password@host:5432/postgres
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
# Model that writes her replies
INTERACTOR_MODEL=
# Reasoning model for background appraisal
THINKING_MODEL=deepseek/deepseek-r1-0528
# Optional: lock the bot to one Telegram user id (otherwise the first person to message it is claimed)
OWNER_TELEGRAM_ID=
TIMEZONE=America/Toronto
